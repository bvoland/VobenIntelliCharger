{
  "name": "pv-charge-controller",
  "version": "0.1.0",
  "description": "Local PV-aware charging controller for Growatt and Easee",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@types/suncalc": "^1.9.2",
    "express": "^5.1.0",
    "hyparquet": "^1.27.1",
    "hyparquet-writer": "^0.16.5",
    "suncalc": "^1.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
